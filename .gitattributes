# ============================================================================
#  08_csi2rk_mipi_imx415  .gitattributes
#
#  为什么需要这个文件:
#    本工程在 Windows 上编辑, 但产物要 scp 到 Linux (RK3576) 上跑。
#    Windows 版 Git 默认 core.autocrlf=true, 会在 checkout 时把 LF 换成 CRLF
#    —— 那样 .sh 脚本在板上会报 "$'\r': command not found", Verilog 文件
#    也可能被 TD 工具链嫌弃。
#
#    这里统一强制 LF, 保证「本地编辑」和「板上运行」用的是同一份字节。
# ============================================================================

# 默认: 文本文件自动识别, 工作区一律用 LF
* text=auto eol=lf

# ---- 明确列出必须 LF 的类型 (给板上直接用的) ----
*.sh    text eol=lf
*.py    text eol=lf
*.c     text eol=lf
*.h     text eol=lf
*.v     text eol=lf
*.vh    text eol=lf
*.sv    text eol=lf
*.do    text eol=lf
*.sdc   text eol=lf
*.adc   text eol=lf
*.dts   text eol=lf
*.dtsi  text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.al    text eol=lf
Makefile text eol=lf
Kconfig  text eol=lf

# ---- 二进制: 不做任何行尾转换 ----
*.png   binary
*.jpg   binary
*.pdf   binary
*.zip   binary
*.bit   binary
*.img   binary
*.so    binary
*.ko    binary
