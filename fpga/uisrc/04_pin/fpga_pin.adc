set_pin_assignment	{ I_sysclk_25m }	{ LOCATION = T16; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_ddr_clk }		{ LOCATION = T13; IOSTANDARD = LVDS18; PULLTYPE = NONE; }
	
# I_button[0]/[1] U17/V17 是 LVDS 差分对, 与参考工程 DSI HS data lane[1] (V17_p+U17_n) 冲突,
# 已让位给 DSI; 如需按键, 请另选可用 LVCMOS18 pin.
# set_pin_assignment	{ I_button[0] }		{ LOCATION = U17; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; }
# set_pin_assignment	{ I_button[1] }		{ LOCATION = V17; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; }
	
# 摄像头 I2C/RST/MCLK -- 严格按参考工程 AFC03_IMX415_PH1A_DSI/uisrc/04_pin/imx415_dsi.adc
set_pin_assignment	{ O_cam_scl }		{ LOCATION = B14; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ IO_cam_sda }		{ LOCATION = A14; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_clk_rst }		{ LOCATION = B18; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment	{ O_clk_24m }		{ LOCATION = A18; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# IMX415 MIPI CSI-2 RX HS lanes (同步参考工程 imx415_dsi.adc)
#
# ---------------------------------------------------------------------------
# 2026-10-20 子卡 FMC_VID005_MIPI 改版 (依据 FMC_VID005_MIPI修改方案.docx 内的子卡原理图)
#   CSI 座 J2 侧: 去掉 100R 的 LP 抽头 (R5/R9/R11/R15/R17/R21/R23/R27/R29/R33),
#                 保留 0R 的 HS 串联 (R6/R7/R12/R13/R18/R19/R24/R25/R30/R31),
#                 终端 R95~R99 (150R/NC) 不动。
#   ==> 网络名与 FMC 引脚号 **一个都没变**, 下面 5 条 HS 约束不用改。
#       P/N 极性也没有翻转 (CSI_DxP -> CSI_HS_DxP 直连)。
#
#   ==> 但 CSI_LP_D0..D3 这 4 对 (8 个脚) 在板子上已经和连接器断开 (悬空):
#         lane0: FMC_HPC_LA07_P/N = B16 / C16
#         lane1: FMC_HPC_LA11_P/N = C15 / D15
#         lane2: FMC_HPC_LA16_P/N = C17 / B17
#         lane3: FMC_HPC_LA15_P/N = F15 / F14
#       (CSI_LP_CKP/CKN 本来就没接 FPGA, 一直没用)
#
#   这 8 个脚的上下拉曾经决定 IP 看到的 LP 电平 (板载已悬空, 只能靠这里):
#      PULLUP   -> P/N 恒为 1 = LP-11 = 总线空闲
#      PULLDOWN -> P/N 恒为 0 = LP-00 = HS 忙态
#   *** 2026-10-20 实测: PULLDOWN(LP-00) 也不行 —— 帧计数仍为 0, 画面纯色块。
#       结论: IP 需要的是 LP 的 **跳变序列** (11->01->00), 恒定电平无论 11/01/00/10
#       都产生不了包边界; 而且 ui_csi_unpacket_4lane 的 S_head_en 要 hs_valid 的
#       上升沿, 恒定 LP 也拿不到。=> "只改 IO 约束" 救不了 cam0。
#       下面已恢复为原来的 PULLUP (装回 100R 后这就是已验证可用状态)。
# ---------------------------------------------------------------------------
set_pin_assignment	{ I_clk_hs_p }		{ LOCATION = E13; IOSTANDARD = LVDS18; PULLTYPE = NONE; }
set_pin_assignment	{ I_data_hs_p[0] }	{ LOCATION = C14; IOSTANDARD = LVDS18; PULLTYPE = NONE; INDEL = 20; }
set_pin_assignment	{ I_data_hs_p[1] }	{ LOCATION = D14; IOSTANDARD = LVDS18; PULLTYPE = NONE; INDEL = 20; }
set_pin_assignment	{ I_data_hs_p[2] }	{ LOCATION = A15; IOSTANDARD = LVDS18; PULLTYPE = NONE; INDEL = 20; }
set_pin_assignment	{ I_data_hs_p[3] }	{ LOCATION = G17; IOSTANDARD = LVDS18; PULLTYPE = NONE; INDEL = 20; }

# =============================================================
# 2026-10-21 临时测试: 第二路 CSI (子卡 J3, 原 DSI 座按厂家方案复用为 CSI 输入)
#
#   子卡 J3 的高速对在 FPGA 侧走 FMC-HPC 网络, 与核心板内部的 MIPIB_* (DSI_TX->RK)
#   是**两套不同的网络和引脚**, 所以互不冲突。
#
#   引脚依据: 硬件手册 FMC-HPC 引脚表(page 41-42) x 子卡 J3 原理图
#     HS_CLK = FMC_HPC_CLK1_M2C_P/N = E16 / F16
#     HS_D0  = FMC_HPC_LA22_P/N     = A13 / B13
#     HS_D1  = FMC_HPC_LA25_P/N     = D18 / E18
#     HS_D2  = FMC_HPC_LA29_P/N     = F18 / G18   (* 设计文档写的 G18/K16 不是差分对, 已修正)
#     HS_D3  = FMC_HPC_LA31_P/N     = K16 / K17
#
#   接法与 cam0 完全一致 (LVDS18 差分输入, data lane 加 INDEL = 20)。
#   JJ 注意: 子卡 J3 原为 DSI 方向, 厂家方案已把串联电阻 150R 改 0R、去掉 LP 分压,
#   所以这里按 **输入** 约束即可; 若 J3 的某对实际未改, 改这里不影响 cam0。
# =============================================================
set_pin_assignment	{ I_clk1_hs_p }		{ LOCATION = E16; IOSTANDARD = LVDS18; PULLTYPE = NONE; }
set_pin_assignment	{ I_data1_hs_p[0] }	{ LOCATION = A13; IOSTANDARD = LVDS18; PULLTYPE = NONE; INDEL = 20; }
set_pin_assignment	{ I_data1_hs_p[1] }	{ LOCATION = D18; IOSTANDARD = LVDS18; PULLTYPE = NONE; INDEL = 20; }
set_pin_assignment	{ I_data1_hs_p[2] }	{ LOCATION = F18; IOSTANDARD = LVDS18; PULLTYPE = NONE; INDEL = 20; }
set_pin_assignment	{ I_data1_hs_p[3] }	{ LOCATION = K16; IOSTANDARD = LVDS18; PULLTYPE = NONE; INDEL = 20; }

# =============================================================
# 2026-10-21 临时测试: 第二路摄像头的控制口 (子卡 J3)
#   MCLK   -> FMC_HPC_LA32_P = N11
#             (厂家改板文档里的 J3_A1 跳线: 去掉 INT_ALM_1V8 的 R671, 贴 R672
#              把 FMC_HPC_LA32_P 引到 J3_A1, 作为 CSI 的功能信号 —— 这里当 MCLK 用)
#   RESETn -> FMC_HPC_LA21_P = H14   (与 cam0 一样恒为 1)
#   SCL/SDA-> FMC_HPC_LA19_P/N = G14/G13 (与 cam0 的 LA20_P/N 接法一致: P=SCL)
# =============================================================
set_pin_assignment	{ O_clk1_24m }		{ LOCATION = N11; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment	{ O_clk1_rst }		{ LOCATION = H14; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; }
set_pin_assignment	{ O_cam1_scl }		{ LOCATION = G14; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ IO_cam1_sda }		{ LOCATION = G13; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# LP 8 脚 (B16/C16, C15/D15, C17/B17, F15/F14) 板载已断开, 且 RTL 已不再使用
# (mipi_csi_rx 只用 5 对 LVDS 解 MIPI), 所以**不再约束** —— 留空即高阻, 与板子现状一致。
# 将来若要恢复 LP 方式的 D-PHY, 把下面 8 条加回来并把 100R 装回即可:
#   set_pin_assignment { I_data_lp_n[0] } { LOCATION = C16; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; }
#   set_pin_assignment { I_data_lp_n[1] } { LOCATION = D15; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; }
#   set_pin_assignment { I_data_lp_n[2] } { LOCATION = B17; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; }
#   set_pin_assignment { I_data_lp_n[3] } { LOCATION = F14; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; }
#   set_pin_assignment { I_data_lp_p[0] } { LOCATION = B16; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; }
#   set_pin_assignment { I_data_lp_p[1] } { LOCATION = C15; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; }
#   set_pin_assignment { I_data_lp_p[2] } { LOCATION = C17; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; }
#   set_pin_assignment { I_data_lp_p[3] } { LOCATION = F15; IOSTANDARD = LVCMOS18; PULLTYPE = PULLUP; }

# =============================================================
# MIPI DSI TX (实质 CSI-2 协议, 4-lane LVDS HS + LVCMOS18 LP)
# 同步参考工程 imx415_dsi.adc, 输出至 RK3576
# =============================================================
set_pin_assignment	{ I_dsi_en }				{ LOCATION = L13; IOSTANDARD = LVCMOS18; PULLTYPE = PULLDOWN; }

# =============================================================
# 反向传参链路: 参数通道 I2C 从机 (地址 0x40)
#
# 引脚选定依据 (2026-10-15 查手册 + 上板实测确认):
#   手册 CON1C 板对板连接器表 (核心板<->底板):
#       A11 | 核心板网表 B12_L20P | 底板网表 I2C9_SCL_M1_MIPI_CSI3_1 | FPGA L18
#       A12 | 核心板网表 B12_L20N | 底板网表 I2C9_SDA_M1_MIPI_CSI3_1 | FPGA M18
#   ==> FPGA 的 L18/M18 直接挂在 RK 的 I2C9 上, **不需要飞线**
#
#   佐证:
#     1) 手册 CSI 连接器表: I2C9_SCL_M1_MIPI_CSI3 -> RK B27 ; SDA -> RK A28
#     2) 厂商设备树 AFH03/csi-imx415-2.dtsi 里:
#          &i2c9 { status="okay"; pinctrl-0=<&i2c9m1_xfer>;
#                  fpga@1a { compatible="milianke,fpga-virtual"; reg=<0x1a>; ... }; };
#        —— 厂商本来就把 FPGA 当作 I2C9 上的从机
#     3) 上板实测: /dev/i2c-9 存在, i2cdetect -y 9 在 0x1a 显示 UU
#        (被内核 fpga@1a 驱动占用)
#
#   ⚠ 从机地址用 0x40 而不是厂商 DTS 里的 0x1a:
#    0x1a 已被内核驱动 claim (i2cdetect 显示 UU), 用户态访问不到。
#    0x40 空闲, 用户态可直接 i2cget/i2cset。
#   ⚠ 从机不做时钟拉伸, 所以 SCL 只读不驱动。
#   ⚠ 曾误选 P14/P15 (FMC_HPC_IIC) —— 那是 FMC 子卡侧的 IIC, 通向子卡摄像头
#    SCCB, 要从 RK 引过去必须飞线。已改为 L18/M18。
# =============================================================
set_pin_assignment	{ IO_cfg_scl }			{ LOCATION = L18; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 4; PULLTYPE = PULLUP; }
set_pin_assignment	{ IO_cfg_sda }			{ LOCATION = M18; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 4; PULLTYPE = PULLUP; }

set_pin_assignment	{ O_mipi_dsi_hs_clk_p }		{ LOCATION = T15; IOSTANDARD = LVDS18; PRE_EMP = ON; VOCM = L2; VOD = 300M; }
set_pin_assignment	{ O_mipi_dsi_hs_data_p[0] }	{ LOCATION = P13; IOSTANDARD = LVDS18; PRE_EMP = ON; VOCM = L2; VOD = 300M; }
set_pin_assignment	{ O_mipi_dsi_hs_data_p[1] }	{ LOCATION = V17; IOSTANDARD = LVDS18; PRE_EMP = ON; VOCM = L2; VOD = 300M; }
set_pin_assignment	{ O_mipi_dsi_hs_data_p[2] }	{ LOCATION = U13; IOSTANDARD = LVDS18; PRE_EMP = ON; VOCM = L2; VOD = 300M; }
set_pin_assignment	{ O_mipi_dsi_hs_data_p[3] }	{ LOCATION = V15; IOSTANDARD = LVDS18; PRE_EMP = ON; VOCM = L2; VOD = 300M; }

#
# ---------------------------------------------------------------------------
# 2026-10-20 子卡改版, DSI 座 J3 侧 (子卡原理图 2/2):
#   原 150R 的 HS 串联 R36/R37/R42/R43/R46/R47/R48/R49/R54/R55/R60/R61 -> 改为 0R;
#   原 120R/60R 的 LP 分压 R34/R35/R38~R41/R44/R45/R50~R53/R56~R59/R62/R63 -> 全去掉。
#   ==> HS 引脚号不变 (T15/P13/V17/U13/V15 以及各自的 N 脚 R15/R13/U17/V12/V16),
#       MIPIB_FLANEn 网络名不变, 极性不变, 下面 5 条 HS 约束不用改。
#   ==> LP 的 5 对 (10 个脚) 板载悬空:
#         PLB_DSI_CLK_P/N = P17 / P18
#         PLB_LANE0_P/N   = T11 / U12
#         PLB_LANE1_P/N   = R11 / R12
#         PLB_LANE2_P/N   = R16 / R17
#         PLB_LANE3_P/N   = T18 / R18
#       这几条也先保留 (输出脚, 悬空无副作用), 免得 TD 自动布线到别的脚。
# ---------------------------------------------------------------------------
set_pin_assignment	{ O_mipi_dsi_lp_clk_p }		{ LOCATION = P17; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment	{ O_mipi_dsi_lp_clk_n }		{ LOCATION = P18; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment	{ O_mipi_dsi_lp_data_p[0] }	{ LOCATION = T11; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment	{ O_mipi_dsi_lp_data_n[0] }	{ LOCATION = U12; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment	{ O_mipi_dsi_lp_data_p[1] }	{ LOCATION = R11; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment	{ O_mipi_dsi_lp_data_n[1] }	{ LOCATION = R12; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment	{ O_mipi_dsi_lp_data_p[2] }	{ LOCATION = R16; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment	{ O_mipi_dsi_lp_data_n[2] }	{ LOCATION = R17; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment	{ O_mipi_dsi_lp_data_p[3] }	{ LOCATION = T18; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; SLEWRATE = FAST; }
set_pin_assignment	{ O_mipi_dsi_lp_data_n[3] }	{ LOCATION = R18; IOSTANDARD = LVCMOS18; DRIVESTRENGTH = 8; SLEWRATE = FAST; }




	
	






















