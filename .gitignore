# ============================================================================
#  08_csi2rk_mipi_imx415  .gitignore
#
#  原则: 只把「人写的、需要 review 的」放进版本库;
#        构建产物、大二进制、快照备份一律排除。
#
#  注意: .gitignore 里 # 只在【行首】是注释, 行尾写注释会被当成模式的一部分!
# ============================================================================

# ---- 备份目录: 本身就是快照, 且占 100+ MB ----
backup/

# ---- 官方参考源码压缩包 (58 MB) ----
*.zip

# ---- FPGA 构建产物 (每次编译都变, 体积还大) ----
# fpga_prj_Runs 是综合/实现结果, 26.5 MB
fpga/fpga_prj_Runs/
# 编译日志
fpga/log/
# TD 内部缓存与状态
fpga/.al/
fpga/.lock.f
fpga/.recent_user_depot.ini
# 比特流 (编译生成)
fpga/*.bit

# ---- RK 端大二进制 (留档在 backup/ 里) ----
# boot.img 45 MB
rk/boot.img

# ---- 仿真产物 ----
*.vvp
*.vcd

# ---- 编译中间产物 ----
*.o
*.so
*.ko
*.ddc
*.lst
__pycache__/
*.pyc

# ---- 调试产物 (可随时重新生成) ----
tools/*.png
tools/_*.txt
/tmp_*

# ---- 系统垃圾 ----
Thumbs.db
desktop.ini
.DS_Store

# TD ����ת��
fpga/*.dmp
